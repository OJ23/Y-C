<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Savour home"><span class="brand-mark">S</span><span>Savour</span></a>
    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
      <a class="nav-discover <%= currentPath === '/' && !currentUser ? 'is-active' : '' %>" href="/">Discover</a>
      <a class="nav-map <%= currentPath.startsWith('/restaurants') && currentPath !== '/restaurants/new' && !currentUrl.includes('view=') ? 'is-active' : '' %>" href="/restaurants">Map</a>
      <a class="nav-recipes <%= currentPath === '/recipes' ? 'is-active' : '' %>" href="/recipes">Dishes</a>
      <% if (currentUser) { %><a class="nav-member-link <%= currentUrl.includes('view=visited') ? 'is-active' : '' %>" href="/restaurants?view=visited">Visited</a><a class="nav-member-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/?tab=places#bookmarks">Saved</a><% } %>
    </nav>
    <div class="nav-actions">
      <% if (!currentUser) { %>
        <a class="text-button" href="/login">Log in</a><a class="button button-primary button-small" href="/register">Create account</a>
      <% } else { %>
        <a class="icon-button" href="/restaurants/new" aria-label="Add restaurant" title="Add restaurant"><i data-lucide="plus" aria-hidden="true"></i></a>
        <span class="user-greeting"><%= currentUser.username %><%= currentUser.role === 'superAdmin' ? ' · Admin' : '' %></span><a class="text-button" href="/logout">Log out</a>
      <% } %>
    </div>
  </div>
</header>
