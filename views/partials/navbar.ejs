<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Savour home"><span class="brand-mark">S</span><span>Savour</span></a>
    <button class="icon-button nav-toggle" type="button" aria-label="Open navigation" aria-controls="primary-nav" aria-expanded="false" data-nav-toggle><i data-lucide="menu" aria-hidden="true"></i><span class="menu-fallback" aria-hidden="true"></span></button>
    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
      <a class="<%= currentPath === '/' ? 'is-active' : '' %>" href="/">Discover</a>
      <a class="<%= currentPath.startsWith('/restaurants') && currentPath !== '/restaurants/new' ? 'is-active' : '' %>" href="/restaurants">Explore map</a>
      <% if (currentUser) { %><a href="/restaurants?view=visited">Visited</a><a href="/restaurants?view=saved">Saved</a><% } %>
    </nav>
    <div class="nav-actions">
      <% if (!currentUser) { %>
        <a class="text-button" href="/login">Log in</a><a class="button button-primary button-small" href="/register">Create account</a>
      <% } else { %>
        <a class="icon-button" href="/restaurants/new" aria-label="Add restaurant" title="Add restaurant"><i data-lucide="plus" aria-hidden="true"></i></a>
        <span class="user-greeting"><%= currentUser.username %><%= currentUser.role === 'superAdmin' ? ' · Admin' : '' %></span><a class="text-button" href="/logout">Log out</a>
      <% } %>
    </div>
  </div>
</header>
