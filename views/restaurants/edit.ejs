<% layout('./layouts/boilerplate') %>
<div class="row">
    <div class="col-md-6 offset-md-3">
    <div class="card shadow">
    <div class="card-body">
    <h4 class="card-title">EDIT A RESTAURANT:</h4>
        <form action="/restaurants/<%= restaurants._id %>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
            <p>
                <div class="mb-3">
                    <label class="form-label" for="title">Title: </label>
                    <input class="form-control" type="text" id= "title" name="restaurants[title]" value="<%= restaurants.title %>" required>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <p>
                <div class="mb-3">
                    <label class="form-label" for="description">Description:</label>
                    <textarea class="form-control" type="text" id= "description" name="restaurants[description]" required> <%= restaurants.description %></textarea>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <p>
                <div class="mb-3">
                    <label class="form-label" for="rating">Rating: </label>
                    <input class="form-control" type="text" id= "rating" name="restaurants[rating]" value="<%= restaurants.rating %>" required>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <p>
                <div class="mb-3">
                    <label class="form-label" for="location">Location:</label>
                    <input class="form-control" type="text" id= "location" name="restaurants[location]" value="<%= restaurants.location %>" required>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <p>
                <div class="mb-3">
                    <label for="formFileMultiple" class="form-label">Upload images:</label>
                    <input class="form-control" type="file" id="formFileMultiple" name="images" multiple>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <p>
                <div class="mb-3">
                    <label class="form-label" for="price">Price:</label>
                    <input class="form-control" type="text" id= "price" name="restaurants[price]" value="<%= restaurants.price %>" required>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
            </p>
            <div class="mb-3">
                <% restaurants.images.forEach((img, i) => { %>
                    <img src="<%= img.thumbnail %>" alt="" srcset="" class="img-thumbnail">
                    <div class="form-check-inline">
                        <input type="checkbox" name="deleteImages[]" id="image-<%= i %>" value="<%= img.filename%>">
                    </div>
                    <label for="image-<%= i %>">DELETE</label>
                <% })%>
            </div>
                <div class="mb-3">
                    <button class="btn btn-info w-100"> UPDATE RESTAURANT</button>
                    <p><a href="/restaurants">HOME</a></p>
                    <p><a href="/restaurants/<%=restaurants._id %>"><-Back</a></p>
                </div>
                <div class="valid-feedback">
                    "looks good!"
                </div>
        </form>
    </div>
    </div>
    </div>
</div>