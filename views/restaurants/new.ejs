<% layout('./layouts/boilerplate') %>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow">
                <div class="card-body">
                <h4 class="card-title">ADD A RESTAURANT:</h4>
                <form action="/restaurants" method="post" enctype="multipart/form-data" novalidate class="needs-validation" >
                    <p>
                        <div class="mb-3">
                            <label class="form-label" for="title">Title: </label>
                            <input class="form-control" type="text" id= "title" name="restaurants[title]" required>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                    <p>
                        <div class="mb-3">
                            <label class="form-label" for="description">Description:</label>
                            <textarea class="form-control" type="text" id= "description" name="restaurants[description]" required></textarea>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                    <p>
                        <div class="mb-3">
                            <label class="form-label" for="rating">Rating: </label>
                            <input class="form-control" type="text" id= "rating" name="restaurants[rating]" required>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                    <div>
                        <input type="file" name="images" multiple>
                    </div>
                    <p>
                        <div class="mb-3">
                            <label class="form-label" for="location">Location:</label>
                            <input class="form-control" type="text" id= "location" name="restaurants[location]" required>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                    <p>
                        <div class="mb-3">
                            <label class="form-label" for="price">Price:</label>
                            <input class="form-control" type="text" id= "price" name="restaurants[price]" required>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                    <p>
                        <div class="mb-3">
                            <button class="btn btn-success w-100"> ADD RESTAURANT</button>
                        </div>
                        <div class="valid-feedback">
                            "looks good!"
                        </div>
                    </p>
                </form>
            </div>
        </div>
    </div>
