<% layout('./layouts/boilerplate') %>
<% const imageList = restaurants.images && restaurants.images.length ? restaurants.images : [{ url: '/images/discovery-hero.jpg' }]; %>

<article class="restaurant-detail">
  <header class="detail-header page-shell">
    <a class="back-link" href="/restaurants"><i data-lucide="arrow-left" aria-hidden="true"></i>Back to discovery</a>
    <div class="detail-title-row">
      <div><p class="eyebrow"><%= restaurants.category ? restaurants.category + ' · ' : '' %><%= restaurants.location || 'Restaurant profile' %></p><h1><%= restaurants.title %></h1><div class="detail-summary"><span class="rating"><i data-lucide="star" aria-hidden="true"></i><%= restaurants.rating || 'Not yet rated' %></span><% if (restaurants.cuisine) { %><span><i data-lucide="utensils" aria-hidden="true"></i><%= restaurants.cuisine %></span><% } %><span><i data-lucide="map-pin" aria-hidden="true"></i><%= restaurants.location || 'Location coming soon' %></span></div></div>
      <div class="detail-actions"><button class="button button-secondary" type="button" data-save-restaurant="<%= restaurants._id %>" aria-pressed="false"><i data-lucide="bookmark" aria-hidden="true"></i><span>Save</span></button><button class="button button-primary" type="button" data-visited-restaurant="<%= restaurants._id %>" aria-pressed="false"><i data-lucide="check" aria-hidden="true"></i><span>Mark visited</span></button></div>
    </div>
  </header>

  <section class="detail-gallery page-shell" aria-label="Restaurant photos">
    <img class="gallery-main" src="<%= imageList[0].url %>" alt="<%= restaurants.title %>" width="960" height="640">
    <div class="gallery-side"><img src="<%= imageList[1] ? imageList[1].url : imageList[0].url %>" alt="Another view of <%= restaurants.title %>" width="480" height="310"><div class="gallery-note"><span><i data-lucide="camera" aria-hidden="true"></i><%= imageList.length %> <%= imageList.length === 1 ? 'photo' : 'photos' %></span><p>Shared by the Savour community</p></div></div>
  </section>

  <div class="detail-content page-shell">
    <div class="detail-main">
      <section class="detail-section"><p class="eyebrow">Why go</p><h2>About this place</h2><p class="detail-description"><%= restaurants.description || 'This restaurant is waiting for a community description.' %></p><% if (restaurants.openingHours || restaurants.phone || restaurants.website) { %><dl class="venue-facts"><% if (restaurants.openingHours) { %><div><dt>Hours</dt><dd><%= restaurants.openingHours %></dd></div><% } %><% if (restaurants.phone) { %><div><dt>Phone</dt><dd><%= restaurants.phone %></dd></div><% } %><% if (restaurants.website) { %><div><dt>Website</dt><dd><a href="<%= restaurants.website.startsWith('http') ? restaurants.website : 'https://' + restaurants.website %>" target="_blank" rel="noopener">Visit website <i data-lucide="external-link" aria-hidden="true"></i></a></dd></div><% } %></dl><% } %><p class="submitted-by"><% if (restaurants.source && restaurants.source.url) { %>Venue data from <a href="<%= restaurants.source.url %>" target="_blank" rel="noopener"><%= restaurants.source.provider %></a><% } else { %>Added by <strong><%= restaurants.author ? restaurants.author.username : 'a community member' %></strong><% } %></p></section>
      <section class="detail-section journal-section"><div class="section-heading compact"><div><p class="eyebrow">Personal memory</p><h2>Your visit notes</h2></div></div><div class="journal-prompt"><i data-lucide="notebook-pen" aria-hidden="true"></i><div><h3>What will you remember?</h3><p>Record a favorite dish, the occasion, or why you would come back.</p></div><button class="button button-secondary" type="button" data-journal-prompt>Add a note</button></div></section>
      <section class="detail-section reviews-section"><div class="section-heading compact"><div><p class="eyebrow">Community notes</p><h2><%= restaurants.reviews.length %> <%= restaurants.reviews.length === 1 ? 'review' : 'reviews' %></h2></div></div>
        <% if (currentUser) { %><form action="/restaurants/<%= restaurants._id %>/reviews" method="post" class="review-form"><fieldset class="starability-fade"><legend>Your rating</legend><input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating"><% for(let i = 1; i <= 5; i++) { %><input type="radio" id="rating-<%= i %>" name="review[rating]" value="<%= i %>"><label for="rating-<%= i %>" title="<%= i %> stars"><%= i %> stars</label><% } %></fieldset><label for="review-body">Share a useful detail</label><textarea id="review-body" name="review[body]" rows="4" placeholder="What stood out about the food, atmosphere, or experience?" required></textarea><button class="button button-primary" type="submit">Post review</button></form><% } else { %><div class="signin-callout"><p>Sign in to add your own note about this restaurant.</p><a href="/login">Log in <i data-lucide="arrow-right" aria-hidden="true"></i></a></div><% } %>
        <div class="review-list"><% restaurants.reviews.forEach(review => { %><article class="review"><div class="review-avatar" aria-hidden="true"><%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'S' %></div><div><div class="review-heading"><div><strong><%= review.author ? review.author.username : 'Community member' %></strong><span class="star-text" aria-label="<%= review.rating %> out of 5 stars"><i data-lucide="star" aria-hidden="true"></i><%= review.rating %></span></div><% if(currentUser && review.author && review.author.equals(currentUser._id)) { %><form action="/restaurants/<%= restaurants._id %>/reviews/<%= review._id %>?_method=DELETE" method="post"><button class="icon-button" type="submit" aria-label="Delete your review" title="Delete review"><i data-lucide="trash-2" aria-hidden="true"></i></button></form><% } %></div><p><%= review.body %></p></div></article><% }) %></div>
      </section>
    </div>
    <aside class="location-panel"><div id="map" class="detail-map"></div><div class="location-copy"><p class="eyebrow">Location</p><h2>Find your way there</h2><p><i data-lucide="map-pin" aria-hidden="true"></i><%= restaurants.location %></p><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(restaurants.location) %>" target="_blank" rel="noopener">Open directions <i data-lucide="external-link" aria-hidden="true"></i></a></div></aside>
  </div>
</article>
<script>window.mapToken = '<%= process.env.MAPTILER_API_KEY %>'; window.restaurantsData = <%- JSON.stringify(restaurants).replace(/</g, '\\u003c') %>;</script>
<script src="/javascripts/showPageMap.js" defer></script>
