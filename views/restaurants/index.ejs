<% layout('./layouts/boilerplate') %>

<div id="map" style="width: 100%; height: 350px;"></div>
    <h1>Restaurant</h1>

    <ul>
        <% for (let restaurant of restaurants) {%>
            <div class="card mb-3">
                <div class="row">
                    <div class="col-md-4">
                        <% if(restaurant.images && restaurant.images.length){ %>
                       <img class="img-fluid" src="<%= restaurant.images[0].url %>" alt="">
                        <%} else{  %>
                             <img class="img-fluid" src="" alt="">
                        <% } %>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title"> <%= restaurant.title %></h5>
                            <p class="card-text"><%= restaurant.description %></p>
                            <p class="card-text">
                                <small class="text-muted"><%= restaurant.location %></small>
                            </p>
                            <a href="restaurants/<%= restaurant._id %>" class="btn btn-primary"> view <%= restaurant.title %></a>
                            <p>
                                <form class="d-inline" action="/restaurants/<%= restaurant._id %>?_method=DELETE" method="post">
                                    <ul><button class="btn btn-danger">DELETE</button></ul>
                                </form>
                            </p>                           
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </ul>
<script defer>
  window.mapToken = '<%= process.env.MAPTILER_API_KEY %>';
  window.restaurantsData = <%- JSON.stringify(restaurants) %>;
  console.log(window.restaurantsData)
</script>
<script src="/javascripts/clusterMap.js" defer></script>