<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% layout('./layouts/boilerplate') %>
    <div class="container d-flex justify-content-center align-items-center mt-0">
            <div class="col-md-4 offset-md-0">
                <div class="card shadow">
                    <img src="/images/IMG_3686.JPG" alt="" class="card-img-top">
                    <div class="card-body">
                    <h5 class="card-title">LOGIN:</h5>
                    <form action="/login" method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label class="form-label" for="Username">Username:</label>
                            <textarea class="form-control" type="text" id= "Username" name="username" autofocus required></textarea>
                            <div class="valid-feedback">
                                "looks good!"
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="Password">Password:</label>
                            <textarea class="form-control" type="text" id= "Password" name="password" required></textarea>
                            <div class="valid-feedback">
                                "looks good!"
                            </div>
                        </div>
                        <button class="btn btn-success w-100">LOGIN</button>
                    </form>
                    </div>
                </div>
            </div>
    </div>
</body>
</html>