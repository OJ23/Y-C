<% layout('./layouts/boilerplate') %>
<section class="auth-page auth-page-login">
  <div class="auth-image"><img src="/images/discovery-hero.jpg" alt="A welcoming restaurant at dusk" width="900" height="1200"><div><p class="eyebrow eyebrow-light">Your places, remembered</p><blockquote>“The best meals deserve more than a forgotten bookmark.”</blockquote></div></div>
  <div class="auth-form-wrap"><form class="auth-form" action="/login" method="post"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span><span>Savour</span></a><p class="eyebrow">Welcome back</p><h1>Return to your table.</h1><p class="auth-lede">Sign in to see your saved places and dining history.</p><div class="field"><label for="username">Username</label><input id="username" name="username" type="text" autocomplete="username" autofocus required></div><div class="field"><div class="label-row"><label for="password">Password</label><a href="#" data-coming-soon>Forgot password?</a></div><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required><button type="button" aria-label="Show password" data-password-toggle><i data-lucide="eye" aria-hidden="true"></i></button></div></div><button class="button button-primary button-full" type="submit">Log in</button><p class="auth-switch">New to Savour? <a href="/register">Create an account</a></p></form></div>
</section>
