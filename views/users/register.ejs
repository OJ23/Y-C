<% layout('./layouts/boilerplate') %>
<section class="auth-page">
  <div class="auth-image"><img src="/images/discovery-hero.jpg" alt="Friends sharing dinner at a city restaurant" width="900" height="1200"><div><p class="eyebrow eyebrow-light">A personal dining map</p><blockquote>Find somewhere new. Remember everywhere that mattered.</blockquote></div></div>
  <div class="auth-form-wrap"><form class="auth-form" action="/register" method="post"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span><span>Savour</span></a><p class="eyebrow"><%= isBootstrapAdmin ? 'Super admin setup' : 'Join Savour' %></p><h1><%= isBootstrapAdmin ? 'Create the super admin.' : 'Start your dining history.' %></h1><p class="auth-lede"><%= isBootstrapAdmin ? 'This first account will receive full administrative access.' : 'Save discoveries and keep the details you want to remember.' %></p><div class="field"><label for="username">Username</label><input id="username" name="username" type="text" autocomplete="username" autofocus required></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required></div><div class="field"><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required><button type="button" aria-label="Show password" data-password-toggle><i data-lucide="eye" aria-hidden="true"></i></button></div><span class="field-hint">Use at least 8 characters.</span></div><button class="button button-primary button-full" type="submit"><%= isBootstrapAdmin ? 'Create super admin' : 'Create account' %></button><p class="auth-switch">Already have an account? <a href="/login">Log in</a></p></form></div>
</section>
